# Backend repair with bounded Office/image decoders; no CUDA/local ML stack.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BUILD_HASH
RUN apt-get update \
    && apt-get install -y --no-install-recommends libwmf-bin emf2svg librsvg2-bin ghostscript \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --only-binary=:all: 'pillow-heif==1.8.1'
COPY backend/open_webui /app/backend/open_webui
COPY backend/start.sh /app/backend/start.sh
ENV WEBUI_BUILD_HASH=${BUILD_HASH}
LABEL org.opencontainers.image.revision=${BUILD_HASH}
LABEL site.shuofang.profile=slim-indexing
